# Copy to secrets.properties (never commit the real file).
# app/build.gradle.kts reads these values and injects them into BuildConfig.
#
# The app still compiles with empty values, but login and other signed API
# calls will fail. Use credentials you are authorized to use; the repository
# does not provide them.
appSecret=change-me
locationSecret=change-me

# CI falls back to these environment variables when secrets.properties is absent:
# QIEKJ_APP_SECRET, QIEKJ_LOCATION_SECRET
# If locationSecret is empty, it falls back to appSecret.
