# Copy to keystore.properties (never commit the real file).
# Relative storeFile paths are resolved against the repository root.
storeFile=keystore/release.jks
storePassword=change-me
keyAlias=release
keyPassword=change-me

# When keystore.properties is absent (for example in CI), the build falls back to:
# RELEASE_STORE_FILE, RELEASE_STORE_PASSWORD, RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD
# All four values must be present, otherwise the release APK stays unsigned.
